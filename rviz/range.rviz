Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: rviz_default_plugins/Range
      Name: Range (raw)
      Enabled: true
      Topic:
        Value: /range
        Depth: 5
        Reliability Policy: Reliable
      Color: 255; 85; 0
      Alpha: 0.6
    - Class: rviz_default_plugins/Range
      Name: Range (filtered)
      Enabled: true
      Topic:
        Value: /range_filtered
        Depth: 5
        Reliability Policy: Reliable
      Color: 0; 170; 255
      Alpha: 0.8
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Name: root
